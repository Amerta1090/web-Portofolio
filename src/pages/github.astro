---
import GitHubUniverse from "../components/organisms/GitHubUniverse.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProfile } from "../lib/data";
import { fetchAllGitHubData } from "../lib/github";

const profile = getProfile();
const gitHubData = await fetchAllGitHubData();
---

<BaseLayout title="GitHub — Abdul Majid Ridwan Tyastonoatmaja" description="Full GitHub universe: repositories, contributions, languages, and activity." ogSlug="github">
  <div class="min-h-screen">
    <GitHubUniverse
      gitHubData={gitHubData}
      profileName={profile.name}
      fullPage={true}
    />
  </div>
</BaseLayout>
