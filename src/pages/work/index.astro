---
/**
 * `/work` (MOTION-18): every project in one place. Merges the old `/projects`
 * index (all projects, category filter) with the old `/work` index (case
 * studies), which listed two of the same projects a second time.
 */
import { type CollectionEntry, getCollection } from "astro:content";
import ProjectFilter from "../../islands/ProjectFilter";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/data";
import { ROUTES, workHref } from "../../lib/routes";

const projects = getProjects();
// The href is resolved here so the island never carries the slug rule.
const filterProjects = projects.map((project) => ({ ...project, href: workHref(project) }));

const entries = await getCollection("caseStudies");
entries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
// Case studies are reached through the project that claims them.
const caseStudies: { entry: CollectionEntry<"caseStudies">; href: string }[] = entries.flatMap(
  (entry: CollectionEntry<"caseStudies">) => {
    const project = projects.find((p) => p.case_study === entry.id);
    return project ? [{ entry, href: workHref(project) }] : [];
  },
);
---

<BaseLayout
  title="Work — Abdul Majid Ridwan Tyastonoatmaja"
  description="Every project — ML, IoT, web, CLI, and DevOps — with case studies for the deepest ones."
  canonicalUrl="https://portfolio.abdulmajidr708.workers.dev/work"
  ogSlug="work"
>
  <div class="py-12 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <header class="mb-12">
        <h1 class="text-h2 font-bold text-text-primary">Work</h1>
        <p class="mt-3 text-text-secondary text-sm">{projects.length} projects across ML, IoT, web, CLI, and DevOps.</p>
      </header>

      {
        caseStudies.length > 0 && (
          <section aria-labelledby="case-studies-heading" class="mb-16" data-work-case-studies>
            <h2 id="case-studies-heading" class="text-h3 font-bold text-text-primary">Case studies</h2>
            <p class="mt-2 mb-6 text-sm text-text-secondary">Deep dives into selected projects and the engineering decisions behind them.</p>
            <div class="grid gap-6 md:grid-cols-2">
              {caseStudies.map(({ entry, href }) => (
                <a
                  href={href}
                  class="block bg-bg-secondary border border-border rounded-xl p-6 hover:border-accent/30 transition-all duration-200 group"
                >
                  <div class="flex items-center justify-between mb-3">
                    {entry.data.category && (
                      <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-accent-muted/20 text-accent rounded-full">{entry.data.category.toUpperCase()}</span>
                    )}
                    <span class="text-xs text-text-secondary">{entry.data.period}</span>
                  </div>

                  <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors">
                    {entry.data.title}
                  </h3>

                  <p class="text-sm text-text-secondary leading-relaxed mb-4">{entry.data.summary}</p>

                  <div class="text-xs text-text-secondary mb-3">{entry.data.role}</div>

                  {entry.data.metrics && entry.data.metrics.length > 0 && (
                    <div class="grid grid-cols-2 gap-3 pt-4 border-t border-border">
                      {entry.data.metrics.slice(0, 4).map((m) => (
                        <div>
                          <div class="text-base font-bold text-brand">{m.value}</div>
                          <div class="text-xs text-text-secondary">{m.label}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section aria-labelledby="all-projects-heading" data-work-all-projects>
        <h2 id="all-projects-heading" class="text-h3 font-bold text-text-primary mb-6">All projects</h2>
        <ProjectFilter client:load projects={filterProjects} baseUrl={ROUTES.work} />
      </section>
    </div>
  </div>
</BaseLayout>
