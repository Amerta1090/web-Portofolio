---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await getCollection("caseStudies");
entries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="Work — Abdul Majid Ridwan Tyastonoatmaja" description="Case studies in AI/ML engineering, IoT systems, and full-stack development." canonicalUrl="https://portfolio.abdulmajidr708.workers.dev/work">
  <div class="py-12 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
          <span class="section-label text-text-secondary">Case Studies</span>
        </div>
        <h1 class="text-h2 font-bold text-text-primary">Work</h1>
        <p class="mt-3 text-text-secondary text-sm">Deep dives into selected projects and the engineering decisions behind them.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {entries.map((entry) => (
          <a
            href={`/work/${entry.id}`}
            class="block bg-bg-secondary border border-border rounded-xl p-6 hover:border-accent/30 transition-all duration-200 group"
          >
            <div class="flex items-center justify-between mb-3">
              {entry.data.category && (
                <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-accent-muted/20 text-accent rounded-full">{entry.data.category.toUpperCase()}</span>
              )}
              <span class="text-xs text-text-secondary">{entry.data.period}</span>
            </div>

            <h2 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors">
              {entry.data.title}
            </h2>

            <p class="text-sm text-text-secondary leading-relaxed mb-4">{entry.data.summary}</p>

            <div class="text-xs text-text-secondary mb-3">{entry.data.role}</div>

            {entry.data.metrics && entry.data.metrics.length > 0 && (
              <div class="grid grid-cols-2 gap-3 pt-4 border-t border-border">
                {entry.data.metrics.slice(0, 4).map((m) => (
                  <div>
                    <div class="text-base font-bold text-brand">{m.value}</div>
                    <div class="text-xs text-text-secondary">{m.label}</div>
                  </div>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>

      {entries.length === 0 && (
        <div class="text-center py-24">
          <p class="text-text-secondary">Case studies coming soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
