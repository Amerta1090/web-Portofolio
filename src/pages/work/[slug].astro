---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, summary, role, stack, period, category, metrics } = entry.data;

const allEntries = await getCollection("caseStudies");
allEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const nextEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
---

<BaseLayout
  title={`${title} — Abdul Majid Ridwan Tyastonoatmaja`}
  description={summary.slice(0, 160)}
  canonicalUrl={`https://portfolio.abdulmajidr708.workers.dev/work/${entry.id}`}
>
  <div class="py-12 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a href="/work" class="text-sm text-text-secondary hover:text-accent transition-colors">&larr; Back to Work</a>
      </div>

      <article class="mx-auto" style="max-width: 65ch;">
        <header class="mb-12">
          {category && (
            <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-medium bg-accent-muted/20 text-accent rounded-full">{category.toUpperCase()}</span>
          )}

          <h1 class="font-display text-text-primary leading-tight mb-4" style="font-size: var(--text-display); line-height: 0.95; letter-spacing: var(--tracking-display);">
            {title}
          </h1>

          <p class="text-lg text-text-secondary leading-relaxed mb-6">{summary}</p>

          <div class="flex flex-wrap items-center gap-4 text-sm text-text-secondary">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-1 h-1 bg-accent rounded-full"></span>
              {role}
            </span>
            <span class="text-border">|</span>
            <span>{period}</span>
          </div>
        </header>

        {metrics && metrics.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12 p-6 bg-bg-secondary border border-border rounded-xl">
            {metrics.map((m) => (
              <div class="text-center">
                <div class="text-2xl md:text-3xl font-bold text-brand mb-1">{m.value}</div>
                <div class="text-xs text-text-secondary uppercase tracking-wide">{m.label}</div>
              </div>
            ))}
          </div>
        )}

        {stack && stack.length > 0 && (
          <div class="mb-12">
            <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-widest mb-3">Tech Stack</h3>
            <div class="flex flex-wrap gap-2">
              {stack.map((s) => (
                <span class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-text-secondary bg-bg-tertiary">
                  {s}
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="border-t border-border pt-10">
          <div class="case-study-content">
            <Content />
          </div>
        </div>

        {(prevEntry || nextEntry) && (
          <div class="mt-16 pt-8 border-t border-border flex flex-wrap justify-between gap-4">
            <div>
              {prevEntry && (
                <a href={`/work/${prevEntry.id}`} class="text-sm text-text-secondary hover:text-accent transition-colors">&larr; {prevEntry.data.title}</a>
              )}
            </div>
            <div>
              {nextEntry && (
                <a href={`/work/${nextEntry.id}`} class="text-sm text-text-secondary hover:text-accent transition-colors">{nextEntry.data.title} &rarr;</a>
              )}
            </div>
          </div>
        )}
      </article>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .case-study-content {
    max-width: 65ch;
  }

  .case-study-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .case-study-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .case-study-content p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .case-study-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .case-study-content ul,
  .case-study-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .case-study-content li {
    margin-bottom: 0.25rem;
  }

  .case-study-content ul li {
    list-style-type: disc;
  }

  .case-study-content ol li {
    list-style-type: decimal;
  }

  .case-study-content code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
    background: var(--bg-tertiary);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--accent);
  }

  .case-study-content pre {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .case-study-content pre code {
    background: none;
    padding: 0;
    color: var(--text-primary);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .case-study-content blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .case-study-content hr {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 2rem 0;
  }
</style>
