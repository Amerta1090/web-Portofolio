---
/**
 * One page per project (MOTION-18). Replaces `/projects/[slug]` (22 project
 * pages) and the old `/work/[slug]` (2 case studies), which described two of the
 * same projects twice. A project that names a `case_study` renders the case
 * study body (stages, metrics, MDX) plus its links; every other project renders
 * the project body. Prev/next walk all 22 in `projects.json` order.
 */
import { type CollectionEntry, getCollection } from "astro:content";
import CaseStudyArticle from "../../components/templates/CaseStudyArticle.astro";
import ProjectArticle from "../../components/templates/ProjectArticle.astro";
import { getProjects } from "../../lib/data";
import { workHref, workSlug } from "../../lib/routes";

export async function getStaticPaths() {
  const projects = getProjects();
  const entries = await getCollection("caseStudies");
  const byId = new Map<string, CollectionEntry<"caseStudies">>(
    entries.map((entry: CollectionEntry<"caseStudies">) => [entry.id, entry]),
  );
  const claimed = new Set(projects.flatMap((project) => project.case_study ?? []));
  const orphans = entries
    .map((entry: CollectionEntry<"caseStudies">) => entry.id)
    .filter((id: string) => !claimed.has(id));
  if (orphans.length > 0) {
    // A case study no project claims would have no URL at all.
    throw new Error(`Case studies without a project: ${orphans.join(", ")}`);
  }

  const neighbour = (index: number) => {
    const project = projects[index];
    return project ? { title: project.title, href: workHref(project) } : null;
  };

  return projects.map((project, index) => {
    const entry = project.case_study ? byId.get(project.case_study) : undefined;
    if (project.case_study && !entry) {
      throw new Error(`Missing case study "${project.case_study}" for "${project.title}"`);
    }
    return {
      params: { slug: workSlug(project) },
      props: { project, entry, prev: neighbour(index - 1), next: neighbour(index + 1) },
    };
  });
}

const { project, entry, prev, next } = Astro.props;
const slug = workSlug(project);
---

{
  entry ? (
    <CaseStudyArticle entry={entry} project={project} slug={slug} prev={prev} next={next} />
  ) : (
    <ProjectArticle project={project} slug={slug} prev={prev} next={next} />
  )
}
