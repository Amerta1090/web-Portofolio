---
import Container from "../components/atoms/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getExperience, getProfile, getSkills } from "../lib/data";

const profile = getProfile();
const experience = getExperience();
const skills = getSkills();
const { contact } = profile;
---

<BaseLayout title="Resume — Abdul Majid Ridwan Tyastonoatmaja" description="Professional resume and career summary. ATS-friendly." canonicalUrl="https://portfolio.abdulmajidr708.workers.dev/resume">
  <div class="print:hidden pt-16">
    <Container>
      <div class="flex items-center justify-between py-6">
        <p class="text-sm text-text-secondary">ATS-optimized. Print or save as PDF.</p>
        <div class="flex gap-3">
          <button id="print-resume" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-white font-medium hover:brightness-110 transition-all text-base shadow-lg shadow-amber-500/20">Print / Save PDF</button>
        </div>
      </div>
    </Container>
  </div>

  <script is:inline>
    document.getElementById("print-resume")?.addEventListener("click", () => window.print());
  </script>

  <div class="max-w-[210mm] mx-auto px-8 sm:px-10 pb-16">
    <article id="resume-content" class="bg-white text-gray-900 shadow-lg print:shadow-none">
      <div class="py-10 px-8 sm:px-12 print:px-8 print:py-8">
        <header class="mb-7">
          <h1 class="text-[26px] font-bold text-gray-900 tracking-tight">{profile.name}</h1>
          <p class="text-sm text-amber-800 font-medium mt-0.5 tracking-wide">{profile.headline}</p>
          <p class="text-xs text-gray-500 mt-2 leading-relaxed">
            {profile.location}
            <span class="text-gray-300 mx-2">|</span>
            {contact.email}
            <span class="text-gray-300 mx-2">|</span>
            {contact.phone}
            <span class="text-gray-300 mx-2">|</span>
            <a href={contact.linkedin} class="text-amber-800 hover:underline">linkedin.com/in/abdulmajidr708</a>
            <span class="text-gray-300 mx-2">|</span>
            <a href={contact.github} class="text-amber-800 hover:underline">github.com/Amerta1090</a>
            <span class="text-gray-300 mx-2">|</span>
            <a href="https://portfolio.abdulmajidr708.workers.dev" class="text-amber-800 hover:underline">portfolio.abdulmajidr708.workers.dev</a>
          </p>
        </header>

        <section class="mb-7">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-[0.15em] border-b border-gray-300 pb-1.5 mb-3">Professional Summary</h2>
          <p class="text-[13px] text-gray-700 leading-[1.65]">{profile.summary}</p>
        </section>

        <section class="mb-7">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-[0.15em] border-b border-gray-300 pb-1.5 mb-3">Experience</h2>
          <div class="space-y-5">
            {experience.map((exp) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <div>
                    <h3 class="text-[14px] font-bold text-gray-900">{exp.role}</h3>
                    <p class="text-[13px] text-amber-800 font-medium">{exp.company}</p>
                  </div>
                  <div class="text-[11px] text-gray-500 text-right whitespace-nowrap">
                    {exp.start_date} — {exp.end_date || "Present"}
                    <br />
                    {exp.location}
                  </div>
                </div>
                {exp.highlights.length > 0 && (
                  <ul class="mt-1 space-y-0.5">
                    {exp.highlights.map((h) => (
                      <li class="text-[13px] text-gray-700 leading-[1.55] flex items-start gap-2">
                        <span class="text-amber-700 mt-[3px] flex-shrink-0 text-[10px]">▸</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section class="mb-7">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-[0.15em] border-b border-gray-300 pb-1.5 mb-3">Skills</h2>
          <div class="text-[13px] grid gap-x-4 gap-y-1" style="grid-template-columns: auto 1fr;">
            {
              skills.categories.flatMap((cat) => [
                <span class="font-semibold text-gray-900">{cat.name}:</span>,
                <span class="text-gray-700">{cat.skills.map((s) => s.name).join(", ")}</span>,
              ])
            }
          </div>
        </section>

        <section>
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-[0.15em] border-b border-gray-300 pb-1.5 mb-3">Education</h2>
          <div class="text-[13px] text-gray-700 leading-relaxed">
            <p class="font-semibold text-gray-900">S.Kom. (Bachelor of Computer Science)</p>
            <p class="text-gray-600">Universitas Amikom Yogyakarta</p>
          </div>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @media print {
    body { background: white !important; }
    .skip-to-content { display: none !important; }
    nav, footer, .print\:hidden { display: none !important; }
    #resume-content { box-shadow: none !important; }
    #resume-content { font-size: 11pt; }
  }
</style>
