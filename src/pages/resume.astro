---
import Container from "../components/atoms/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getExperience, getProfile, getSkills } from "../lib/data";

const profile = getProfile();
const experience = getExperience();
const skills = getSkills();
const { contact } = profile;
const nameParts = profile.name.split(" ");
const initials = nameParts.map((n) => n[0]).join("").slice(0, 2).toUpperCase();
---

<BaseLayout title="Resume — Abdul Majid Ridwan Tyastonoatmaja" description="Professional resume and career summary." canonicalUrl="https://abdulmajidr708.dev/resume">
  <div class="print:hidden pt-16">
    <Container>
      <div class="flex items-center justify-between py-6">
        <p class="text-sm text-text-secondary">Use the button below to download or print a PDF version of this resume.</p>
        <div class="flex gap-3">
          <button id="download-pdf" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-white font-medium hover:brightness-110 transition-all duration-200 text-base shadow-lg shadow-amber-500/20">Download PDF</button>
          <button id="print-resume" class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-border text-text-primary font-medium hover:bg-bg-tertiary transition-all duration-200 text-base">Print</button>
        </div>
      </div>
    </Container>
  </div>

  <script is:inline>
    document.getElementById("download-pdf")?.addEventListener("click", () => window.print());
    document.getElementById("print-resume")?.addEventListener("click", () => window.print());
  </script>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <article class="bg-white text-gray-900 rounded-2xl shadow-2xl overflow-hidden print:rounded-none print:shadow-none" id="resume-content">
      <div class="md:flex print:flex">
        <aside class="md:w-80 print:w-80 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 text-white p-8 flex-shrink-0 print:bg-gray-900">
          <div class="text-center mb-8">
            <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-2xl font-bold text-white mb-4 shadow-lg shadow-amber-500/30">
              {initials}
            </div>
            <h1 class="text-2xl font-bold text-white">{profile.name}</h1>
            <p class="text-amber-400 font-medium text-sm mt-1">{profile.headline}</p>
            <p class="text-gray-400 text-xs mt-1">{profile.location}</p>
          </div>

          <div class="space-y-6">
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-3 border-b border-gray-700 pb-2">Contact</h2>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="break-all">{contact.email}</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  <span>{contact.phone}</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  <a href={contact.linkedin} class="hover:text-amber-400 transition-colors truncate" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/></svg>
                  <a href={contact.github} class="hover:text-amber-400 transition-colors truncate" target="_blank" rel="noopener noreferrer">GitHub</a>
                </li>
              </ul>
            </div>

            <div>
              <h2 class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-3 border-b border-gray-700 pb-2">Skills</h2>
              <div class="space-y-3">
                {skills.categories.map((cat) => (
                  <div>
                    <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1.5">{cat.name}</h3>
                    <div class="flex flex-wrap gap-1.5">
                      {cat.skills.map((s) => (
                        <span class="inline-flex items-center px-2 py-0.5 text-xs bg-gray-700/60 text-gray-200 rounded-md border border-gray-700">{s.name}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </aside>

        <div class="flex-1 p-8 sm:p-10 print:p-8">
          <section class="mb-8">
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
              <span class="w-1 h-6 bg-amber-500 rounded-full inline-block"></span>
              Professional Summary
            </h2>
            <p class="text-gray-700 leading-relaxed text-sm">{profile.summary}</p>
          </section>

          <section class="mb-8">
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
              <span class="w-1 h-6 bg-amber-500 rounded-full inline-block"></span>
              Experience
            </h2>
            <div class="space-y-6">
              {experience.map((exp, i) => (
                <div class="relative pl-6 border-l-2 border-gray-200">
                  <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-amber-500 border-2 border-white shadow-sm" />
                  <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                      <h3 class="font-semibold text-gray-900">{exp.role}</h3>
                      <p class="text-amber-600 font-medium text-sm">{exp.company}</p>
                    </div>
                    <div class="text-xs text-gray-500 text-right flex-shrink-0">
                      <p>{exp.start_date} — {exp.end_date || "Present"}</p>
                      <p>{exp.location}</p>
                    </div>
                  </div>
                  <ul class="mt-2 space-y-1">
                    {exp.highlights.map((h) => (
                      <li class="text-sm text-gray-600 flex items-start gap-2">
                        <span class="text-amber-500 mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-amber-500/60" />
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
              <span class="w-1 h-6 bg-amber-500 rounded-full inline-block"></span>
              Education
            </h2>
            <div class="text-sm text-gray-700 space-y-1">
              <p class="font-medium text-gray-900">S.Kom. (Bachelor of Computer Science)</p>
              <p class="text-gray-600">Universitas Amikom Yogyakarta</p>
            </div>
          </section>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  @media print {
    body { background: white !important; }
    .skip-to-content { display: none !important; }
    nav, footer, .print\:hidden { display: none !important; }
    #resume-content { box-shadow: none !important; border-radius: 0 !important; }
    aside { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  @media screen {
    aside { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
