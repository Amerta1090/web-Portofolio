---
import { ArrowRight, Calendar, Briefcase, GraduationCap, Award } from "lucide-react";
import Container from "../components/atoms/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTimeline } from "../lib/data";

const timelineItems = getTimeline();
const years = [...new Set(timelineItems.map((item) => item.year))].sort((a, b) => b - a);

function typeIcon(type: string) {
  if (type === "work") return "work";
  if (type === "internship") return "internship";
  return "cert";
}

function typeIconPath(type: string): string {
  if (type === "work") return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />';
  if (type === "internship") return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />';
  return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />';
}
---

<BaseLayout title="Timeline — Abdul Majid Ridwan Tyastonoatmaja" description="Technical timeline covering experience, education, and certifications." canonicalUrl="https://portfolio.abdulmajidr708.workers.dev/timeline" ogSlug="timeline/index">
  <div class="pt-24 pb-16">
    <Container>
      <header class="mb-12" data-reveal>
        <h1 class="text-4xl md:text-6xl font-bold text-text-primary mb-3">
          <span class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent">Timeline</span>
        </h1>
        <p class="text-text-secondary text-lg">Experience, education, and certifications through the years.</p>
      </header>

      <div class="flex gap-8 lg:gap-12">
        <nav class="hidden md:flex flex-col gap-1 sticky top-28 self-start flex-shrink-0 w-28" aria-label="Year navigation">
          <span class="text-xs font-semibold text-text-secondary mb-3 uppercase tracking-wider">Jump to year</span>
          <div class="border-l-2 border-border pl-3 space-y-0.5">
            {
              years.map((year) => (
                <a href={`#year-${year}`} class="block px-3 py-1.5 text-sm text-text-secondary hover:text-amber-400 hover:border-l-2 hover:-ml-[14px] hover:pl-[10px] border-l-2 border-transparent transition-all duration-200">
                  {year}
                </a>
              ))
            }
          </div>
        </nav>

        <div class="flex-1 min-w-0">
          <div class="relative">
            <div class="absolute left-[7px] top-0 bottom-0 w-0.5 bg-gradient-to-b from-amber-500/60 via-amber-400/30 to-transparent hidden md:block" />

            <div class="space-y-20">
              {
                years.map((year, yi) => {
                  const yearItems = timelineItems.filter((item) => item.year === year);
                  return (
                    <section id={`year-${year}`} class="relative pl-0 md:pl-8" data-reveal>
                      <div class="flex items-center gap-4 mb-8 md:absolute md:-left-1 md:top-0">
                        <div class="hidden md:flex w-5 h-5 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 border-[3px] border-bg-primary flex-shrink-0 z-10 shadow-lg shadow-amber-500/20" />
                        <h2 class="text-3xl md:text-4xl font-bold text-text-primary">{year}</h2>
                        <span class="text-sm text-text-secondary bg-bg-tertiary px-3 py-0.5 rounded-full">{yearItems.length} event{yearItems.length !== 1 ? "s" : ""}</span>
                      </div>

                      <div class="space-y-6 mt-4 md:mt-0">
                        {
                          yearItems.map((item) => (
                            <article class="group relative bg-gradient-to-br from-bg-secondary to-bg-secondary/80 border border-border/80 rounded-xl p-6 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5 transition-all duration-300">
                              <div class="md:flex md:items-start md:justify-between md:gap-6">
                                <div class="flex-1 min-w-0 mb-3 md:mb-0">
                                  <div class="flex flex-wrap items-center gap-2 mb-2">
                                    <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-medium rounded-full capitalize
                                      ${item.type === 'work' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : ''}
                                      ${item.type === 'internship' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' : ''}
                                      ${item.type === 'certification' ? 'bg-green-500/10 text-green-400 border border-green-500/20' : ''}
                                    `}>
                                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        {typeIconPath(item.type)}
                                      </svg>
                                      {item.type === "work" ? "Work" : item.type === "internship" ? "Internship" : "Cert"}
                                    </span>
                                    <span class="text-xs text-text-secondary flex items-center gap-1">
                                      <Calendar class="w-3 h-3" />
                                      {item.date}
                                    </span>
                                  </div>
                                  <h3 class="text-lg font-bold text-text-primary group-hover:text-amber-400 transition-colors duration-200">{item.title}</h3>
                                  <p class="text-sm text-text-secondary mt-0.5">{item.subtitle}</p>
                                </div>
                              </div>

                              {item.highlights.length > 0 && (
                                <ul class="space-y-1.5 mb-4 mt-3">
                                  {item.highlights.map((h) => (
                                    <li class="text-sm text-text-secondary flex gap-2">
                                      <span class="text-amber-400 mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-amber-400/60" />
                                      <span class="leading-relaxed">{h}</span>
                                    </li>
                                  ))}
                                </ul>
                              )}

                              <div class="flex flex-wrap items-center justify-between gap-3">
                                {item.tags.length > 0 && (
                                  <div class="flex flex-wrap gap-1.5">
                                    {item.tags.map((tag) => (
                                      <span class="inline-flex items-center px-2.5 py-0.5 text-xs bg-bg-tertiary text-text-secondary rounded-md border border-border/50 group-hover:border-amber-500/10 transition-colors duration-200">{tag}</span>
                                    ))}
                                  </div>
                                )}

                                {item.url && (
                                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-amber-400 hover:text-amber-300 font-medium transition-colors ml-auto">
                                    View details <ArrowRight class="w-3.5 h-3.5" />
                                  </a>
                                )}
                              </div>
                            </article>
                          ))
                        }
                      </div>
                    </section>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <script is:inline>
    document.querySelectorAll('nav a[href^="#year-"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const target = document.querySelector(link.getAttribute("href") || "");
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  </script>
</BaseLayout>
