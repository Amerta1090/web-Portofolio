---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../islands/GalleryGrid";
---

<BaseLayout
  title="Creative Lab — Engineering Showcase"
  description="25 interactive engines — fluid solvers, FFT visualizers, WebGL fractals, N-body gravity, and ML demos. Every simulation written from scratch."
  canonicalUrl="https://portfolio.abdulmajidr708.workers.dev/gallery"
  ogSlug="gallery"
>
  <div class="min-h-screen pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-16 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse" />
          Engineering Showcase
        </div>
        <h1 class="text-5xl md:text-7xl font-black text-text-primary mb-4 tracking-tight">
          <span class="bg-gradient-to-r from-amber-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">
            Creative Lab
          </span>
        </h1>
        <p class="text-text-secondary text-lg max-w-2xl mx-auto">
          25 interactive engines, each built from scratch — numerical integrators, shaders, solvers, and simulations that double as proof I can turn math into working software. Click any experiment to launch it.
        </p>
      </header>

      <GalleryGrid client:load />
    </div>
  </div>
</BaseLayout>
