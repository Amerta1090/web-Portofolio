---
/**
 * MOTION-26 (M26.2): Full-bleed graded portrait hero ("The dark room", D-13).
 *
 * Replaces `TimeAwareHero` + `HeroAvatar` + `RevealText` + `hero-metrics` with a
 * zero-JS Astro section: name across the top, lede + one lime action at the
 * foot. Constraints from `docs/motion/archive/SPRINT_PLAN-done.md` (MOTION-26) & `SESSION_LOG.md`:
 * - Display name <= 5.2 rem max so it stays above the portrait at 1440.
 * - CTA uses `white-space: nowrap` so it never wraps into a tall pill at 375.
 * - Pure CSS entrance (`hero-drift`, `hero-rise`, `hero-fade`), disabled under
 *   `prefers-reduced-motion: reduce` and `prefers-reduced-data: reduce`.
 */
import type { Profile } from "../../types/profile";

export interface Props {
  profile: Profile;
  /** How many flagships the stage below shows; the CTA promises exactly that. */
  flagshipCount: number;
}

const { profile, flagshipCount } = Astro.props;
const shortName = profile.name.split(" ").slice(0, 2).join(" ");
const city = profile.location.split(",")[0]?.trim() ?? profile.location;
const WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"];
const countWord = WORDS[flagshipCount] ?? String(flagshipCount);
---

<section
  id="hero"
  class="hero-room"
  aria-labelledby="hero-title"
>
  <picture class="hero-picture" aria-hidden="true">
    <source
      type="image/webp"
      srcset="/images/hero/hero-bg-768.webp 768w, /images/hero/hero-bg-1280.webp 1280w, /images/hero/hero-bg-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      class="hero-photo"
      src="/images/hero/hero-bg-1920.jpg"
      alt={`${shortName} on a bench between the two halves of an iron gate, the hills of ${city} behind him`}
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="hero-falloff" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 id="hero-title" class="hero-title">
      <span>{shortName}</span>
    </h1>

    <div class="hero-lede">
      <p>AI/ML engineer in {city}, shipping systems that turn data into decisions.</p>
      <a class="hero-cta" href="#projects">See {countWord} shipped systems</a>
    </div>
  </div>
</section>

<style>
  .hero-room {
    position: relative;
    margin-top: -4rem;
    height: 100svh;
    min-height: 660px;
    overflow: clip;
    background: #0b0b0a;
    color: #f2f2ee;
  }

  .hero-picture {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0% 55%;
    filter: brightness(0.5) saturate(0.72) contrast(1.06);
    animation: hero-drift 26s linear both;
  }

  .hero-falloff {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        60% 75% at 74% 72%,
        rgba(11, 11, 10, 0) 0%,
        rgba(11, 11, 10, 0.55) 70%,
        rgba(11, 11, 10, 0.82) 100%
      ),
      linear-gradient(0deg, rgba(11, 11, 10, 0.72) 0%, rgba(11, 11, 10, 0) 50%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 6rem max(24px, env(safe-area-inset-left)) 3.5rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 6.2vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    overflow: clip;
    color: #f2f2ee;
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
    padding-bottom: 0.06em;
    animation: hero-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-lede {
    grid-row: 3;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 44rem;
    animation: hero-fade 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  .hero-lede p {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.875rem);
    line-height: 1.3;
    max-width: 38ch;
    color: #f2f2ee;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 600;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    padding: 1rem 1.75rem;
    text-decoration: none;
    transition:
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.18s ease;
  }

  .hero-cta:hover {
    background: var(--color-brand-muted);
  }

  .hero-cta:active {
    transform: scale(0.97);
  }

  .hero-cta:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(102%);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .hero-photo {
      object-position: 72% 60%;
    }
  }

  @media (max-width: 760px) {
    .hero-room {
      min-height: 620px;
    }

    .hero-photo {
      object-position: 68% 60%;
      filter: brightness(0.46) saturate(0.72) contrast(1.06);
    }

    .hero-falloff {
      background: linear-gradient(
        180deg,
        rgba(11, 11, 10, 0.58) 0%,
        rgba(11, 11, 10, 0.1) 30%,
        rgba(11, 11, 10, 0.1) 52%,
        rgba(11, 11, 10, 0.85) 100%
      );
    }

    /* The assistant button is fixed in the bottom-right corner (~80 px with
       its offset); at 320 px it would cover the CTA's end without this foot. */
    .hero-inner {
      padding: 5.25rem max(18px, env(safe-area-inset-left)) 5.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 13.5vw, 4rem);
    }

    .hero-lede {
      gap: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (prefers-reduced-data: reduce) {
    .hero-photo,
    .hero-title span,
    .hero-lede {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
