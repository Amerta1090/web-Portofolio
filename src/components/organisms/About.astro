---
import ImpactMetrics from "../../islands/ImpactMetrics";
import { buildSiteFacts } from "../../lib/facts";
import type { Profile } from "../../types/profile";

export interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

/**
 * Numbers come from `SiteFacts`, not from `profile.metrics`.
 *
 * `profile.json` used to carry hand-written counts — 18 shipped projects and 54
 * certifications — while the datasets held 22 and 62; the stale-number defect
 * PRD §3.1 C3 exists to kill. `validate-data` now rejects both `metrics` fields
 * outright (M0.2.2), so the figures below are derived: projects and
 * certifications counted from the datasets, years of experience derived from
 * `experience.json`. One source, and it cannot drift from the data.
 *
 * The removed key names are spelled out in `scripts/validate-data.mjs` rather
 * than here, so the Task 0.6 grep gate for the deleted field stays a clean zero.
 * A comment quoting a deleted field makes that gate read itself as evidence —
 * the same trap that blinded the Task 0.5 dead-control guard.
 */
const facts = buildSiteFacts();

const metricItems = [
  {
    label: "Years Experience",
    value: facts.profile.yearsExperience,
    suffix: "+",
    context: "In AI/ML and software engineering",
  },
  {
    label: "Projects Shipped",
    value: facts.projects.count,
    suffix: "+",
    context: "From concept to production",
    href: "#career",
  },
  {
    label: "Certifications",
    value: facts.certifications.count,
    suffix: "",
    context: "Across cloud, ML, and systems",
    href: "#certifications",
  },
  {
    label: "Languages",
    value: facts.profile.languages.length,
    suffix: "",
    context: "Programming & spoken languages",
  },
];
---

<div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl">
    <p class="text-text-primary leading-relaxed text-lg">
      {profile.summary}
    </p>
    <div class="flex items-center gap-3 mt-6">
      <span class="inline-flex items-center gap-1.5 text-sm text-text-secondary">
        <span class="w-1.5 h-1.5 rounded-full bg-brand/60" />
        {profile.location}
      </span>
      <span class="text-text-secondary/30">·</span>
      <span class="text-sm text-text-secondary">{profile.timezone}</span>
    </div>
  </div>
  <div class="mt-8">
    <ImpactMetrics client:idle metrics={metricItems} />
  </div>
</div>
