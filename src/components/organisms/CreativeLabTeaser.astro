---
/**
 * The Creative Lab teaser (Prove It Task 2.5; cut to six in MOTION-19).
 *
 * The home gives developers a reason to visit the lab without turning into the
 * gallery itself: six thumbnails picked by the written rule in
 * `lib/lab-teaser.ts` (one per category, plus one flagship), every one a deep
 * link into `/lab`. The whole catalog — all experiments, grouped by category —
 * lives on `/lab`.
 *
 * Server HTML only: no island, no script, no inline handler (Astro does not
 * escape `on*` attributes, so a dead control here is something to count, not
 * assume). The total printed is `SiteFacts.lab.count` (Rule 7 / P8), never a
 * literal in this file.
 *
 * MOTION-07 presentation hooks stay: `data-lab-sheet` on the wrapper (the
 * chapter body opts out of its single-beat reveal through it) and
 * `data-lab-card-reveal` on each thumbnail, with `--lab-card-order` emitted
 * from the selection order, so no JavaScript is added.
 */
import type { LabGalleryExperiment } from "../../lib/lab-gallery";
import { ROUTES, labHref } from "../../lib/routes";

interface Props {
  /** Total experiments in the lab (`SiteFacts.lab.count`). */
  count: number;
  /** The selection to show, in order (`buildLabTeaser()`). */
  picks: LabGalleryExperiment[];
}

const { count, picks } = Astro.props;
---

<div class="space-y-8" data-lab-sheet>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <p class="max-w-2xl text-sm text-text-secondary">
      <span class="font-mono tabular-nums text-text-primary" data-lab-picks>{picks.length}</span>
      {" "}of <span class="font-mono tabular-nums text-text-primary" data-lab-count>{count}</span>
      {" "}interactive experiments — one from each category, plus a flagship. Every
      one is written from scratch and runs entirely in your browser; each thumbnail
      opens the live experiment in the lab.
    </p>
    <a
      href={ROUTES.lab}
      class="group inline-flex shrink-0 items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-5 py-2.5 text-sm font-medium text-accent transition-colors hover:border-accent/50 hover:bg-accent/20"
    >
      All experiments in the lab
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>

  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    {picks.map((exp, cardIndex) => (
      <li data-lab-card-reveal style={{ "--lab-card-order": String(cardIndex) }}>
        <a
          href={labHref(exp.id)}
          data-lab-card
          data-lab-category={exp.category}
          class="group/card block overflow-hidden rounded-xl border border-border/50 bg-bg-tertiary/60 transition-colors hover:border-accent/50"
        >
          <div class="relative aspect-[16/9] overflow-hidden bg-bg-secondary">
            <img
              src={exp.thumbnail}
              alt=""
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
              class="h-full w-full object-cover opacity-80 transition-opacity duration-300 group-hover/card:opacity-100"
            />
          </div>
          <div class="px-3 py-2.5">
            <span class="block truncate text-sm font-medium text-text-primary transition-colors group-hover/card:text-accent">
              {exp.title}
            </span>
            <span class="block truncate text-xs text-text-secondary">{exp.category}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>