---
import { Activity, Calendar, Flame } from "lucide-react";
import BootSequence from "../../islands/BootSequence";
import CodeDNAHelix from "../../islands/CodeDNAHelix";
import GitHubCommandCenter from "../../islands/GitHubCommandCenter";
import GitHubPhase3 from "../../islands/GitHubPhase3";
import PhaseIndicator from "../../islands/PhaseIndicator";
import type { GitHubData } from "../../types/github";
import Container from "../atoms/Container.astro";
import DataFreshness from "../atoms/DataFreshness.astro";
import Section from "../molecules/Section.astro";

export interface Props {
  gitHubData: GitHubData;
  profileName: string;
  fullPage?: boolean;
}

const { gitHubData, profileName, fullPage = false } = Astro.props;
const hasData = gitHubData.pinned_repos.length > 0 || gitHubData.top_repos.length > 0;
const repos = gitHubData.pinned_repos.length ? gitHubData.pinned_repos : gitHubData.top_repos;
const buildTime = new Date().toISOString();
---

{
  !hasData ? (
    <Section title="GitHub Universe" ariaLabel="GitHub universe">
      <Container>
        <div class="text-center py-16">
          <p class="text-text-secondary text-lg mb-4">GitHub data will appear here after the next build.</p>
          <p class="text-text-secondary text-sm">
            Make sure <code class="font-mono px-2 py-0.5 bg-bg-tertiary rounded">GITHUB_TOKEN</code> is set and run the build again.
          </p>
        </div>
      </Container>
    </Section>
  ) : (
    <div class="github-universe relative">
      {fullPage && <PhaseIndicator client:load />}

      <!-- Phase 0: Boot Sequence -->
      <div data-phase="boot">
        <BootSequence
          client:visible
          gitHubData={gitHubData}
          profileName={profileName}
        />
      </div>

      <!-- Phase 1: CodeDNA Helix -->
      <div data-phase="dna">
        <Section title="CodeDNA Helix" subtitle="Your coding identity mapped to a genetic sequence" variant="alt" ariaLabel="Code DNA helix">
          <Container>
            <CodeDNAHelix client:visible gitHubData={gitHubData} />
          </Container>
        </Section>
      </div>

      <!-- Phase 2: Command Center -->
      <div data-phase="metrics">
        <Section title="Command Center" subtitle="Live metrics from the developer universe" ariaLabel="GitHub metrics dashboard">
          <Container>
            <div class="flex items-center justify-between mb-6">
              <p class="text-text-secondary text-sm">Aggregated stats from all public repositories</p>
              <DataFreshness fetchedAt={buildTime} label="Built" />
            </div>
            <GitHubCommandCenter client:visible gitHubData={gitHubData} />
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="group relative overflow-hidden rounded-xl border border-border/40 bg-gradient-to-br from-bg-secondary/80 to-bg-secondary/40 p-5 transition-all duration-300 hover:border-brand/30 hover:shadow-lg hover:shadow-brand/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10">
                    <Flame class="h-5 w-5 text-brand" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-2xl font-bold text-text-primary tabular-nums tracking-tight">{gitHubData.derived_metrics.longest_streak}<span class="text-base font-normal text-text-secondary ml-1">days</span></p>
                    <p class="mt-0.5 text-xs text-text-secondary/60">Longest streak</p>
                  </div>
                </div>
                <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/5 pointer-events-none" />
              </div>
              <div class="group relative overflow-hidden rounded-xl border border-border/40 bg-gradient-to-br from-bg-secondary/80 to-bg-secondary/40 p-5 transition-all duration-300 hover:border-brand/30 hover:shadow-lg hover:shadow-brand/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10">
                    <Activity class="h-5 w-5 text-brand" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-2xl font-bold text-text-primary capitalize tabular-nums tracking-tight">{gitHubData.derived_metrics.most_active_day}</p>
                    <p class="mt-0.5 text-xs text-text-secondary/60">Most active day</p>
                  </div>
                </div>
                <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/5 pointer-events-none" />
              </div>
              <div class="group relative overflow-hidden rounded-xl border border-border/40 bg-gradient-to-br from-bg-secondary/80 to-bg-secondary/40 p-5 transition-all duration-300 hover:border-brand/30 hover:shadow-lg hover:shadow-brand/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10">
                    <Calendar class="h-5 w-5 text-brand" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-2xl font-bold text-text-primary tabular-nums tracking-tight">{gitHubData.derived_metrics.busiest_month}</p>
                    <p class="mt-0.5 text-xs text-text-secondary/60">Busiest month</p>
                  </div>
                </div>
                <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/5 pointer-events-none" />
              </div>
            </div>
          </Container>
        </Section>
      </div>

      <!-- Phases 3+4: Repository Galaxy + Language Nebula + Top Repos leaderboard (composite island) -->
      <GitHubPhase3
        client:visible
        repos={repos}
        gitHubData={gitHubData}
        topRepos={gitHubData.top_repos}
        repoActivity={gitHubData.repo_activity}
      />
    </div>
  )
}
