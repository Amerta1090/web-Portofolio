---
export interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
import HeaderTools from "../../islands/HeaderTools";
import { isCurrentPage } from "../../lib/page-continuity";
import Container from "../atoms/Container.astro";
import ThemeToggle from "../atoms/ThemeToggle.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/#career", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/observatory", label: "Observatory" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bg-primary/80 backdrop-blur-md border-b border-border" role="banner">
  <Container>
    <nav class="flex items-center justify-between h-16" aria-label="Primary">
      <a href="/" class="text-xl font-bold text-text-primary hover:text-brand transition-colors" aria-label="Home">
        AMERTA
      </a>
      <ul class="hidden lg:flex items-center gap-5 list-none">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-text-secondary hover:text-brand transition-colors"
                data-nav-link
                aria-current={isCurrentPage(link.href, currentPath) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="hidden lg:inline-flex items-center gap-2 h-9 px-3 rounded-lg border border-border bg-bg-secondary text-text-secondary hover:text-brand hover:border-brand/40 transition-colors"
          aria-label="Cari (⌘K)"
          data-cursor-hover="button"
          onclick="window.dispatchEvent(new CustomEvent('opencode:palette'))"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <span class="text-sm">Cari</span>
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono leading-none rounded bg-bg-tertiary border border-border text-text-secondary/70">⌘K</kbd>
        </button>
        <button
          type="button"
          class="grid lg:hidden place-items-center h-9 w-9 rounded-lg text-text-secondary hover:text-brand hover:bg-bg-secondary transition-colors"
          aria-label="Cari (⌘K)"
          title="Cari (⌘K)"
          data-cursor-hover="button"
          onclick="window.dispatchEvent(new CustomEvent('opencode:palette'))"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>
        <button
          type="button"
          class="grid lg:hidden place-items-center h-9 w-9 rounded-lg text-text-secondary hover:text-brand hover:bg-bg-secondary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          aria-label="Menu"
          aria-controls="mobile-nav"
          aria-expanded="false"
          data-mobile-nav-trigger
          data-cursor-hover="button"
        >
          <svg class="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
          <svg class="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <HeaderTools client:load />
        <div class="w-px h-5 bg-border mx-1"></div>
        <ThemeToggle />
      </div>
    </nav>
  </Container>
</header>

<!--
  Mobile sheet menu (G1 / 21st Δ1) — panel sebagai sibling dari <header>, BUKAN child:
  header memakai backdrop-blur-md (containing-block untuk fixed descendants).
  State = attribute `data-mobile-nav-open` pada <html> (pola ThemeToggle),
  di-toggle oleh inline script di bawah — 0 React root, 0 scroll listener.
-->
<div
  id="mobile-nav"
  data-mobile-nav-panel
  class="lg:hidden"
  aria-hidden="true"
>
  <div data-mobile-nav-backdrop class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm" tabindex="-1"></div>
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    class="fixed inset-y-0 right-0 z-[70] flex w-72 max-w-[85vw] flex-col bg-bg-primary border-l border-border shadow-2xl"
  >
    <div class="flex items-center justify-between h-16 shrink-0 px-4 border-b border-border">
      <span class="text-sm font-medium text-text-primary">Menu</span>
      <button
        type="button"
        data-mobile-nav-close
        class="grid place-items-center h-9 w-9 rounded-lg text-text-secondary hover:text-brand hover:bg-bg-secondary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Tutup menu"
        data-cursor-hover="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Mobile">
      <ul class="list-none flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-mobile-nav-link
                class="flex items-center rounded-lg px-3 py-2.5 text-sm text-text-secondary hover:text-brand hover:bg-bg-secondary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                data-nav-link
                aria-current={isCurrentPage(link.href, currentPath) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  /* Ikon trigger: Menu ↔ X mengikuti state <html> */
  [data-mobile-nav-trigger] .mobile-nav-icon-close {
    display: none;
  }
  html[data-mobile-nav-open] [data-mobile-nav-trigger] .mobile-nav-icon-close {
    display: block;
  }
  html[data-mobile-nav-open] [data-mobile-nav-trigger] .mobile-nav-icon-open {
    display: none;
  }

  /* Panel: default tertutup (visibility hidden → tak focusable), open via state <html> */
  [data-mobile-nav-panel] [data-mobile-nav-backdrop],
  [data-mobile-nav-panel] [role="dialog"] {
    visibility: hidden;
  }
  [data-mobile-nav-panel] [data-mobile-nav-backdrop] {
    opacity: 0;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }
  [data-mobile-nav-panel] [role="dialog"] {
    transform: translateX(100%);
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }
  html[data-mobile-nav-open] [data-mobile-nav-panel] [data-mobile-nav-backdrop],
  html[data-mobile-nav-open] [data-mobile-nav-panel] [role="dialog"] {
    visibility: visible;
  }
  html[data-mobile-nav-open] [data-mobile-nav-panel] [data-mobile-nav-backdrop] {
    opacity: 1;
    transition: opacity 0.2s ease, visibility 0s;
  }
  html[data-mobile-nav-open] [data-mobile-nav-panel] [role="dialog"] {
    transform: translateX(0);
    transition: transform 0.3s ease, visibility 0s;
  }

  /* reduced-motion: tanpa slide (presen instan) — tanpa JS guard */
  @media (prefers-reduced-motion: reduce) {
    [data-mobile-nav-panel] [data-mobile-nav-backdrop],
    [data-mobile-nav-panel] [role="dialog"],
    html[data-mobile-nav-open] [data-mobile-nav-panel] [data-mobile-nav-backdrop],
    html[data-mobile-nav-open] [data-mobile-nav-panel] [role="dialog"] {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var trigger = document.querySelector("[data-mobile-nav-trigger]");
    var panel = document.querySelector("[data-mobile-nav-panel]");
    if (!trigger || !panel) return;
    var lastFocused = null;

    // Window-scoped scroll lock (M4.3.4): protokol dataset yang SAMA dengan
    // `src/lib/scroll-lock.ts` (`data-scroll-lock-count` /
    // `data-scroll-lock-prev`), di-mirror dengan tangan karena script
    // `is:inline` tak bisa import modul — kelas DEVIASI yang sama dengan trap
    // M4.3.2. Key harus tetap identik dengan `COUNT_ATTR`/`PREV_ATTR` di sana;
    // kalau key melenceng, dua overlay saling melepas lock (bug laten M4.2.3).
    var readLockCount = function () {
      var raw = document.body.dataset.scrollLockCount;
      if (raw == null || raw === "") return 0;
      var n = parseInt(raw, 10);
      return isFinite(n) && n > 0 ? n : 0;
    };

    var acquireScrollLock = function () {
      var body = document.body;
      var count = readLockCount();
      if (count === 0) {
        body.dataset.scrollLockPrev = body.style.overflow;
        body.dataset.scrollLockCount = "1";
        body.style.overflow = "hidden";
      } else {
        body.dataset.scrollLockCount = String(count + 1);
      }
    };

    var releaseScrollLock = function () {
      var body = document.body;
      var count = readLockCount();
      if (count > 1) {
        body.dataset.scrollLockCount = String(count - 1);
        return;
      }
      if (count === 1) {
        body.style.overflow = body.dataset.scrollLockPrev || "";
        delete body.dataset.scrollLockCount;
        delete body.dataset.scrollLockPrev;
      }
    };

    var isOpen = function () {
      return root.hasAttribute("data-mobile-nav-open");
    };

    // `inert` konten belakang (M4.3.3): main + footer tak bisa difokus,
    // diklik, atau dibaca SR saat sheet terbuka; dilepas saat tertutup.
    // Header SENGAJA tak ikut — trigger di dalamnya harus tetap bisa diklik
    // (`inert` memblokir klik juga, bukan cuma fokus); keyboard sudah dikurung
    // trap M4.3.2 dan `aria-modal="true"` menyatakan modalitas ke SR.
    // Tak ada `inert` pre-existing di repo (audit M4.3.1), jadi removeAttribute
    // polos aman — tak ada milik orang lain yang bisa terhapus.
    var setBackgroundInert = function (on) {
      var targets = [];
      var main = document.getElementById("main-content");
      if (main) targets.push(main);
      var footer = document.querySelector("footer");
      if (footer && targets.indexOf(footer) === -1) targets.push(footer);
      targets.forEach(function (el) {
        if (on) {
          el.setAttribute("inert", "");
        } else {
          el.removeAttribute("inert");
        }
      });
    };

    var open = function () {
      lastFocused = document.activeElement;
      acquireScrollLock();
      root.setAttribute("data-mobile-nav-open", "");
      trigger.setAttribute("aria-expanded", "true");
      panel.setAttribute("aria-hidden", "false");
      setBackgroundInert(true);
      var first = panel.querySelector("[data-mobile-nav-close]");
      if (first && typeof first.focus === "function") first.focus();
    };

    var close = function () {
      root.removeAttribute("data-mobile-nav-open");
      trigger.setAttribute("aria-expanded", "false");
      panel.setAttribute("aria-hidden", "true");
      setBackgroundInert(false);
      releaseScrollLock();
      if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
      lastFocused = null;
    };

    trigger.addEventListener("click", function () {
      if (isOpen()) {
        close();
      } else {
        open();
      }
    });

    var backdrop = panel.querySelector("[data-mobile-nav-backdrop]");
    if (backdrop && typeof backdrop.addEventListener === "function") {
      backdrop.addEventListener("click", close);
    }
    var closeBtn = panel.querySelector("[data-mobile-nav-close]");
    if (closeBtn && typeof closeBtn.addEventListener === "function") {
      closeBtn.addEventListener("click", close);
    }
    panel.querySelectorAll("[data-mobile-nav-link]").forEach(function (a) {
      a.addEventListener("click", close);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && isOpen()) {
        e.preventDefault();
        close();
        return;
      }
      // Focus trap (M4.3.2): Tab/Shift+Tab cycle di dalam dialog saat terbuka.
      // Ekuivalen vanilla dari `useFocusTrap` (React hook — tak bisa di-import
      // script `is:inline`, jadi logikanya di-mirror di sini, bukan hook-nya
      // dipakai ulang; lihat DEVIASI di plan). Tanpa ini Tab lolos ke konten
      // belakang (terbukti probe M4.3.1: TAB_ESCAPED=true).
      if (e.key === "Tab" && isOpen()) {
        var dialog = panel.querySelector('[role="dialog"]');
        var scope = dialog || panel;
        var focusables = scope.querySelectorAll(
          'button:not([disabled]):not([tabindex="-1"]),' +
            '[href]:not([tabindex="-1"]),' +
            "input:not([disabled])," +
            "textarea:not([disabled])," +
            "select:not([disabled])," +
            '[tabindex]:not([tabindex="-1"])',
        );
        if (focusables.length === 0) {
          e.preventDefault();
          return;
        }
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        var active = document.activeElement;
        var inside = active ? scope.contains(active) : false;
        if (e.shiftKey) {
          if (!inside || active === first) {
            e.preventDefault();
            last.focus();
          }
        } else if (!inside || active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>