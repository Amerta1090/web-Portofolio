---
export interface Props {
  title?: string;
  subtitle?: string;
  id?: string;
  variant?: "default" | "alt";
  class?: string;
  ariaLabel?: string;
  /**
   * Opt the section into the chapter reveal system.
   *
   * A chapter is two beats, not one: the head (label, title, subtitle) settles
   * first, then the body (the slot) follows. The ranges live in
   * `src/lib/scroll-animations.css`; this component only publishes the hooks.
   *
   * The old `data-reveal` prop faded the section's single layout wrapper as one
   * block, so a long chapter arrived all at once with no hierarchy cue. Pages
   * that put `data-reveal` on their own containers keep the legacy path.
   */
  chapter?: boolean;
  /**
   * Clip overflowing content to the section's box.
   *
   * `true` by default, which is what every section has always done. But
   * `overflow: hidden` makes the section a **scroll container**, and `position:
   * sticky` resolves against the nearest scrollport — so a sticky descendant of a
   * clipping section never pins: it scrolls away with the page, silently, with its
   * computed `position` still saying `sticky`. Measured on `#career`: the rail's
   * wrapper tracked scroll 1:1 (371 → −29 → −429 → −829) instead of holding 96px,
   * and the four year headings never reached their 80px pin.
   *
   * Pass `false` for a section whose content needs to pin to the viewport.
   * Nothing inside a `Section` relies on the clip for legibility, so this is a
   * layout decision for the caller rather than a safety net worth defaulting on.
   */
  clip?: boolean;
}

const {
  title,
  subtitle,
  id,
  variant = "default",
  class: className,
  ariaLabel,
  chapter = false,
  clip = true,
} = Astro.props;

const cls = `py-16 md:py-32 relative ${clip ? "overflow-hidden " : ""}container-query-section ${variant === "alt" ? "bg-bg-secondary border-y border-border" : ""} ${className ?? ""}`;
const chapterAttr = chapter ? { "data-chapter": "" } : {};
const headAttr = chapter ? { "data-chapter-head": "" } : {};
const bodyAttr = chapter ? { "data-chapter-body": "" } : {};
---

<section id={id} class={cls} aria-label={ariaLabel ?? title} {...chapterAttr}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 relative z-10">
    {
      title && (
        <div class="mb-12" {...headAttr}>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
            <span class="section-label text-text-secondary">Section</span>
          </div>
          <h2 class="text-h2 font-bold text-text-primary">
            {title}
          </h2>
          {subtitle && (
            <div class="mt-3">
              <p class="text-text-secondary text-sm">{subtitle}</p>
            </div>
          )}
        </div>
      )
    }
    <div {...bodyAttr}><slot /></div>
  </div>
</section>
