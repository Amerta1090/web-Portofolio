---
export interface Props {
  title?: string;
  subtitle?: string;
  id?: string;
  variant?: "default" | "alt";
  class?: string;
  ariaLabel?: string;
  /**
   * Opt the section into the chapter reveal system.
   *
   * A chapter is two beats, not one: the head (label, title, subtitle) settles
   * first, then the body (the slot) follows. The ranges live in
   * `src/lib/scroll-animations.css`; this component only publishes the hooks.
   *
   * The old `data-reveal` prop faded the section's single layout wrapper as one
   * block, so a long chapter arrived all at once with no hierarchy cue. Pages
   * that put `data-reveal` on their own containers keep the legacy path.
   */
  chapter?: boolean;
}

const {
  title,
  subtitle,
  id,
  variant = "default",
  class: className,
  ariaLabel,
  chapter = false,
} = Astro.props;

// `overflow: clip`, never `overflow: hidden`: both clip the same pixels, but
// `hidden` also makes the section a **scroll container**, and two things resolve
// against the nearest scrollport:
//
// - `position: sticky` descendants stop pinning (they scroll away with the page
//   while their computed `position` still says `sticky`). Measured on `#career`
//   in MOTION-03: the rail's wrapper tracked scroll 1:1 (371 → −29 → −429 →
//   −829) instead of holding 96px.
// - `animation-timeline: view()` descendants lose their timeline. A section that
//   never scrolls yields a degenerate range, so every reveal inside it reports
//   `playState: "finished"` and sits at its `to` keyframe — the chapter reveal
//   system was silently inert in every clipped section. Measured in MOTION-04:
//   with `overflow: hidden` on `#projects`, the card wrapper read `opacity: 1 /
//   progress: 1` at every scroll offset; `overflow: clip` on the same element
//   restored the beat (0 → 0.115 → 0.543 → 0.971 → 1 across 200 px of scroll).
//
// Nothing inside a `Section` relies on being unclipped, so clipping stays the
// default and there is no per-section escape hatch to keep in sync.
const cls = `py-16 md:py-32 relative overflow-clip container-query-section ${variant === "alt" ? "bg-bg-secondary border-y border-border" : ""} ${className ?? ""}`;
const chapterAttr = chapter ? { "data-chapter": "" } : {};
const headAttr = chapter ? { "data-chapter-head": "" } : {};
const bodyAttr = chapter ? { "data-chapter-body": "" } : {};
---

<section id={id} class={cls} aria-label={ariaLabel ?? title} {...chapterAttr}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 relative z-10">
    {
      title && (
        <div class="mb-12" {...headAttr}>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
            <span class="section-label text-text-secondary">Section</span>
          </div>
          <h2 class="text-h2 font-bold text-text-primary">
            {title}
          </h2>
          {subtitle && (
            <div class="mt-3">
              <p class="text-text-secondary text-sm">{subtitle}</p>
            </div>
          )}
        </div>
      )
    }
    <div {...bodyAttr}><slot /></div>
  </div>
</section>
