---
import "../styles/global.css";
import "../styles/theme.css";
import "../lib/scroll-animations.css";
import "../lib/layout-queries.css";
import ClientRouter from "astro/components/ClientRouter.astro";
import { Toaster } from "sonner";
import Footer from "../components/templates/Footer.astro";
import Header from "../components/templates/Header.astro";
import AmbientScene from "../islands/AmbientScene";
import AssistantBot from "../islands/AssistantBot";
import CommandPalette from "../islands/CommandPalette";
import CustomCursor from "../islands/CustomCursor";
import { SITE } from "../lib/constants";
import { buildFaqLd } from "../lib/data";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogSlug?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage,
  ogSlug,
  ogType = "website",
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl ?? SITE.url;
const ogImageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${SITE.url}${ogImage}`
  : ogSlug
    ? `${SITE.url}/og/${ogSlug}.png`
    : `${SITE.url}/og/index.png`;
const currentPath = Astro.url.pathname;

const faqLd = buildFaqLd();

const cfAnalyticsToken = import.meta.env.CF_ANALYTICS_TOKEN;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.author} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" id="favicon" />
    <link rel="canonical" href={canonical} />
    <ClientRouter />

    <script is:inline type="application/ld+json">
      {JSON.stringify(Astro.props.jsonLd ?? {
        "@context": "https://schema.org",
        "@type": "Person",
        name: SITE.author,
        jobTitle: "AI/ML Engineer & Systems Builder",
        url: SITE.url,
        sameAs: [SITE.github, SITE.linkedin],
      })}
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

    <link rel="preload" href="/fonts/fraunces-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        const prefetched = new Set();
        const prefetch = (url) => {
          if (prefetched.has(url)) return;
          prefetched.add(url);
          const link = document.createElement("link");
          link.rel = "prefetch";
          link.href = url;
          document.head.appendChild(link);
        };
        document.addEventListener("mouseover", (e) => {
          const a = e.target.closest?.("a");
          if (a && a.href && a.href.startsWith(location.origin) && !a.href.includes("#")) {
            prefetch(a.href);
          }
        }, { passive: true });
        document.addEventListener("touchstart", (e) => {
          const a = e.target.closest?.("a");
          if (a && a.href && a.href.startsWith(location.origin) && !a.href.includes("#")) {
            prefetch(a.href);
          }
        }, { passive: true });
      })();
    </script>

    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme-mode");
        if (!stored) {
          try {
            var z = localStorage.getItem("theme");
            if (z) { var p = JSON.parse(z); if (p && p.state) stored = p.state.theme; }
          } catch (e) {}
        }
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "light" || (!stored && !prefersDark)) {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <script is:inline>
      (function () {
        /* ── Lightning Mode override ── */
        try {
          var stored = localStorage.getItem("experience-tier");
          if (stored) {
            var parsed = JSON.parse(stored);
            if (parsed && parsed.state && parsed.state.lightningMode) {
              document.documentElement.dataset.experienceTier = "tier-1";
              return;
            }
          }
        } catch (e) {}

        /* ── Auto-detect experience tier ── */
        var isMobile = window.matchMedia("(max-width: 768px)").matches;
        var prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var memory = navigator.deviceMemory || 8;
        var cores = navigator.hardwareConcurrency || 4;
        var hasWebGL = false;
        try {
          var c = document.createElement("canvas");
          hasWebGL = !!(c.getContext("webgl") || c.getContext("webgl2"));
        } catch (e) {}
        var tier = "tier-3";
        if (isMobile || prefersReduced || memory <= 2 || cores <= 2) {
          tier = "tier-1";
        } else if (memory <= 4 || cores <= 4 || !hasWebGL) {
          tier = "tier-2";
        }
        document.documentElement.dataset.experienceTier = tier;
      })();
    </script>

    <script is:inline>
      (function () {
        const updateFavicon = function () {
          const isDark = document.documentElement.classList.contains("dark");
          const link = document.getElementById("favicon");
          if (link) {
            link.setAttribute("href", isDark ? "/favicon.svg" : "/favicon-light.svg");
          }
        };
        const observer = new MutationObserver(function () { updateFavicon(); });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        updateFavicon();
      })();
    </script>

    <script is:inline>
      (function () {
        var hour = new Date().getHours();
        var warmth;
        if (hour >= 5 && hour < 7) warmth = 0.6;
        else if (hour >= 7 && hour < 12) warmth = 0.8;
        else if (hour >= 12 && hour < 17) warmth = 1.0;
        else if (hour >= 17 && hour < 21) warmth = 0.7;
        else warmth = 0.3;
        var v = Math.round(warmth * 255);
        document.documentElement.style.setProperty(
          "--color-brand-warm-rgb",
          v + " " + Math.round(v * 0.7) + " " + Math.round(v * 0.4)
        );
      })();
    </script>

    {cfAnalyticsToken && (
      <script is:inline data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })} src="https://static.cloudflareinsights.com/beacon.min.js" defer></script>
    )}
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary">
    <div
      class="noise-overlay"
      aria-hidden="true"
      style={`background-image:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>`)}");background-size:200px 200px`}
    ></div>

    <AmbientScene client:visible />
    <div class="relative z-10">
      <a href="#main-content" class="skip-to-content">Skip to content</a>
      <div class="scroll-progress-css" role="progressbar" aria-label="Page scroll progress"></div>

      <div transition:persist="header">
        <Header currentPath={currentPath} />
      </div>
      <main id="main-content" class="pt-16" role="main" transition:animate="fade">
        <slot />
      </main>
      <div transition:persist="footer">
        <Footer />
      </div>
    </div>
    <Toaster
      client:idle
      position="bottom-right"
      toastOptions={{
        style: {
          background: "var(--color-surface-secondary)",
          color: "var(--color-text-primary)",
          border: "1px solid var(--color-border)",
          boxShadow: "var(--shadow-3)",
        },
      }}
    />

    <AssistantBot client:load />
    <CommandPalette client:load />
    <CustomCursor client:load />

    <script is:inline>
      (function () {
        if (document.documentElement.dataset.experienceTier === "tier-1") return;

        import("https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js").then(function (mod) {
          var Lenis = mod.default;
          var lenis = new Lenis({
            duration: 1.2,
            easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
            orientation: "vertical",
            smoothWheel: true
          });
          window.__LENIS = lenis;

          function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);

          document.addEventListener("click", function (e) {
            var link = e.target.closest("a");
            if (!link) return;
            var href = link.getAttribute("href");
            if (!href || !href.startsWith("/#")) return;
            var id = href.replace("/#", "");
            var el = document.getElementById(id);
            if (!el) return;
            e.preventDefault();
            lenis.scrollTo(el, { offset: -64 });
          }, { passive: false });

          if (window.location.hash) {
            var id = window.location.hash.replace("#", "");
            var el = document.getElementById(id);
            if (el) setTimeout(function () { lenis.scrollTo(el, { offset: -64 }); }, 100);
          }
        });
      })();
    </script>
  </body>
</html>
